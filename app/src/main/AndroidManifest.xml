<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Translation runs in this app while others are in front: ask to be exempt
         from battery optimisation, or its background network is cut. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".AllTransApp"
        android:forceQueryable="true"
        android:allowBackup="false"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="AllowBackup,GoogleAppIndexingWarning"
        tools:targetApi="r">
        <meta-data android:name="android.max_aspect"
            android:value="5.0"/>

        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Stores the in-app UI language on Android 12 and older (AppCompat). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <provider
            android:authorities="${applicationId}.SharedPrefProvider"
            android:name="akhil.alltrans.SharedPrefProvider"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
        <provider
            android:authorities="${applicationId}.GtransProvider"
            android:name="akhil.alltrans.GtransProvider"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
        <provider
            android:authorities="${applicationId}.EdgeProvider"
            android:name="akhil.alltrans.EdgeProvider"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
        <provider
            android:authorities="${applicationId}.VietPhraseProvider"
            android:name="akhil.alltrans.VietPhraseProvider"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>

</manifest>
