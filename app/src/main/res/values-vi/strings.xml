    <string name="notif">"Dịch thông báo"</string>
    <string name="notif_summary_off">"Không dịch văn bản trong thông báo. Bật để bật tính năng này."</string>
    <string name="notif_summary_on">"Đang dịch văn bản trong thông báo. An toàn nhưng đôi khi có thể làm ứng dụng bị lỗi. Tắt để tắt tính năng này."</string>


    <string name="caching">"Bật bộ nhớ đệm"</string>
    <string name="caching_summary_off">"Không lưu bộ nhớ đệm bản dịch. Việc dịch có thể chậm hơn và dùng nhiều dữ liệu mạng hơn, nhưng có thể hoạt động tốt hơn với một số ứng dụng. Bật để lưu bộ nhớ đệm."</string>
    <string name="caching_summary_on">"Đang lưu bộ nhớ đệm bản dịch để tăng tốc độ và giảm các yêu cầu mạng lặp lại. Tắt nếu ứng dụng đã dịch hoạt động không ổn định."</string>

    <string name="delay">"Độ trễ trước khi thay thế bằng bản dịch"</string>
    <string name="delay_summary">"Đặt thời gian chờ (mili giây) trước khi thay thế bằng bản dịch. Mặc định là 0. Đặt 1000–5000 nếu ứng dụng bị lỗi sau khi dịch."</string>

    <string name="delay_webview">"Độ trễ trước khi bắt đầu dịch WebView"</string>
    <string name="delay_webview_summary">"Đặt thời gian chờ (mili giây) trước khi bắt đầu dịch WebView. Mặc định là 500. Đặt 0 để tăng tốc dịch. Đặt 3000–5000 nếu một phần nội dung web chưa được dịch."</string>

    <string name="scroll">"Tự cuộn bản dịch dài"</string>
    <string name="scroll_summary_off">"Bản dịch không vừa chỗ sẽ bị cắt bằng “…”."</string>
    <string name="scroll_summary_on">"Bản dịch không vừa chỗ sẽ chạy qua lại. Không thay đổi focus, thao tác chạm hay cuộn của ứng dụng."</string>

    <string name="debug">"Nâng cao: Bật chế độ gỡ lỗi."</string>
    <string name="debug_summary_off">"Chế độ gỡ lỗi đang tắt. Không ghi dữ liệu gỡ lỗi vào logcat. Hãy bật tính năng này trước khi gửi báo cáo lỗi."</string>
    <string name="debug_summary_on">"Chế độ gỡ lỗi đang bật. Nhật ký được ghi vào logcat. Điều này làm giảm hiệu năng; hãy tắt nếu không cần."</string>

