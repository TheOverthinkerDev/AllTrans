    <string name="extended_view_translation">"Dịch mở rộng cho View"</string>
    <string name="extended_view_translation_summary_off">"Chỉ dùng đường dịch gốc của TextView và setText. Các hook mở rộng như StaticLayout.Builder.build(), hàm khởi tạo layout, phương thức của framework View và setter của View tùy chỉnh sẽ bị tắt."</string>
    <string name="extended_view_translation_summary_on">"Bật các hook dịch bổ sung ngoài đường TextView gốc, bao gồm StaticLayout.Builder.build(), hàm khởi tạo layout, phương thức của framework View và setter của View tùy chỉnh."</string>

    <string name="webView">"Dịch văn bản trong WebView"</string>
    <string name="webView_summary_off">"Không dịch văn bản trong WebView. Bật để bật tính năng này."</string>
